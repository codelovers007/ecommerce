<h5>All Categories</h5>
<table>
  <thead>
    <tr>
      <th>
        Category Name
      </th>
    </tr>
  <thead>
  <tbody>
    <% @categories.each do |category| %>
      <tr>
        <td><%= category.name %></td>
      </tr>
    <% end %>
  <tbody>
</table>

<h5>All Products</h5>
<%= link_to '+Product Create', new_admin_product_path %>

<table>
  <thead>
    <tr>
      <th>
        Product Name
      </th>
      <th>
        Description
      </th>
      <th>
        Category Name
      </th>
      <th>
        Price
      </th>
      <th>
        Sku_nu
      </th>
      <th>
        Stock
      </th>
    </tr>
  <thead>
  <tbody>
    <% @products.each do |product| %>
      <tr>
        <td><%= product.name %></td>
        <td><%= product.description %></td>
        <td><%= product.category.name %></td>
        <td><%= product.price %></td>
        <td><%= product.sku_nu %></td>
        <td><%= product.stock %></td>
        <td><%= link_to 'Edit', edit_admin_product_path(product) %></td>
        <td><%= link_to 'Delete', admin_product_path(product), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %></td>
      </tr>
    <% end %>
  <tbody>
</table>