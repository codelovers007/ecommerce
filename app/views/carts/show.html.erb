<% if @cart.cart_items.any? %>
  <p>We have cart items</p>
  <table class="admin-table cart-table">
    <thead>
      <tr>
        <th>Product</th>
        <th>Price</th>
        <th>Quantity</th>
        <th>Subtotal</th>
        <th>Actions</th>
      <tr>
    </thead>
    <tbody>
      <% @cart.cart_items.each do |cart_item| %>
        <tr>
          <td><%= cart_item.product.name %></td>
          <td><%= number_to_currency(cart_item.product.price, unit: '₹') %></td>
          <td>
            <%= form_with url: cart_item_path(cart_item), method: :patch do |f| %>
              <%= f.number_field :quantity, value: cart_item.quantity, min: 1, class: "qty-input", onChange: "this.form.requestSubmit()" %>
            <% end %>
          </td>
          <td><%= number_to_currency(cart_item.subtotal, unit: '₹') %></td>
          <td><%= button_to 'Remove', cart_item_path(cart_item), method: :delete, class: 'btn' %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <div class="cart-summary">
    <div class="cart-total">
      <span>Total Amount</span>
      <span class="cart-total-amount"><%= number_to_currency(@cart.total_price, unit: '₹') %></span>
    </div>
    <%= link_to 'Continue Shopping', products_path, class: "btn" %>
    <%= link_to 'Checkout', '#', class: "btn" %>
  </div>
<% else %>
  <p>You don't have any cart product</p>
  <%= link_to "Browse Products", products_path, class: "btn", style: "margin-top: 1rem;" %>
<% end %>
