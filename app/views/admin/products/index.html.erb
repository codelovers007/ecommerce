<div class="page">
  <div class="page-header">
    <h3>Admin &raquo; Products</h3>
    <%= link_to "New Product", new_admin_product_path, class: "btn" %>
  </div>

  <div class="list-section">
    <h4>Products:</h4>

    <table class="admin-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Price</th>
          <th class="actions-col">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @products.each do |product| %>
          <tr>
            <td><%= product.name %></td>
            <td><%= number_to_currency(product.price) %></td>
            <td class="actions-col">
              <div class="row-actions">
                <%= link_to "View", admin_product_path(product), class: "btn btn-outline btn-sm" %>
                <%= link_to "Edit", edit_admin_product_path(product), class: "btn btn-outline btn-sm" %>
                <%= button_to "Delete", admin_product_path(product), method: :delete,
                      form_class: "inline-form",
                      class: "btn btn-outline btn-sm btn-danger",
                      data: { turbo_confirm: "Delete #{product.name}?" } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <% if @products.empty? %>
      <div class="empty-state">No products yet.</div>
    <% end %>
  </div>
</div>