<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "E Commerce App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="E Commerce App">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <div class="container">
        <%= link_to "E Commerce App", root_path, class: "brand" %>

        <nav class="nav-links">
          <%= link_to "Home", root_path %>
          <%= link_to cart_path do %>
            Cart
            <span><%= current_cart.cart_items.sum(:quantity) %></span>
          <% end %>

          <% if logged_in? %>
            <% if current_user.respond_to?(:admin?) && current_user.admin? %>
              <%= link_to "Admin", admin_products_path %>
            <% end %>
            <%= button_to "Logout", sessions_path, method: :delete, form_class: "inline-form", class: "btn btn-outline btn-sm" %>
          <% else %>
            <%= link_to "Products", products_path %>
            <%= link_to "Login", new_sessions_path, class: "btn btn-outline btn-sm" %>
            <%= link_to "Sign up", new_registrations_path, class: "btn btn-sm" %>
          <% end %>
        </nav>
      </div>
    </header>

    <% flash.each do |type, message| %>
      <div class="flash flash-<%= type %>">
        <%= message %>
      </div>
    <% end %>

    <%= yield %>
  </body>
</html>
