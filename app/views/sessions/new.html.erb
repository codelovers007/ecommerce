<div class="page">
  <h1>Sessions#new</h1>

  <div class="card">
    <%= form_with url: sessions_path, method: :post, html: { class: "form" } do |f| %>
      <div class="form-field">
        <%= f.label :email %>
        <%= f.email_field :email %>
      </div>

      <div class="form-field">
        <%= f.label :password %>
        <%= f.password_field :password %>
      </div>

      <%= f.submit "Login" %>
    <% end %>
  </div>

  <%= link_to "sing up", new_registrations_path %>
</div>
