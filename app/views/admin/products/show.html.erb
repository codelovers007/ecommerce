<div class="page">
  <h1>Product Details</h1>

  <div class="card product-detail">
    <h4 class="product-category"><%= @product.category.name %></h4>

    <div class="attr">
      <span class="attr-value"><%= image_tag @product.image, width: 100, height: 100 %></span>
    </div>

    <div class="attr">
      <span class="attr-label">Name</span>
      <span class="attr-value"><%= @product.name %></span>
    </div>
    <div class="attr">
      <span class="attr-label">Description</span>
      <span class="attr-value"><%= @product.description %></span>
    </div>
    <div class="attr">
      <span class="attr-label">Sku No</span>
      <span class="attr-value"><%= @product.sku_nu %></span>
    </div>
    <div class="attr">
      <span class="attr-label">Price</span>
      <span class="attr-value"><%= @product.price %></span>
    </div>
    <div class="attr">
      <span class="attr-label">Stock</span>
      <span class="attr-value"><%= @product.stock %></span>
    </div>
  </div>

  <%= link_to 'back', admin_products_path, class: "back-link" %>
</div>
