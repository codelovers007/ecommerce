<div class="page">
  <h1>Registrations#new</h1>

  <div class="card">
    <%= form_with model: @user, url: registrations_path, method: :post, html: { class: "form" } do |form| %>
      <div class="form-field">
        <%= form.label :name %>
        <%= form.text_field :name %>
      </div>

      <div class="form-field">
        <%= form.label :email %>
        <%= form.email_field :email %>
      </div>

      <div class="form-field">
        <%= form.label :password %>
        <%= form.password_field :password %>
      </div>

      <div class="form-field">
        <%= form.label :password_confirmation %>
        <%= form.password_field :password_confirmation %>
      </div>

      <%= form.submit "Sign Up" %>
    <% end %>
  </div>

  <%= link_to "Login", new_sessions_path %>
</div>
